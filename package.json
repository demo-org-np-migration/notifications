{
  "name": "notifications",
  "version": "1.0.0",
  "description": "Consumidor de notificaciones (email/push) y API de preferencias de Cauri",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",

  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.637.0",
    "@cauri/commons": "github:demo-org-np-migration/cauri-commons-js#v1.1.0",
    "express": "^4.19.2",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "aws-sdk-client-mock": "^4.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
